name: Alpha Oracle Pro v15.5

# 路徑：.github/workflows/alpha_oracle.yml
#
# v15.5 改動：
# - 主掃描每分鐘跑（cron: '* * * * *'）
# - 純 tick check 每 30 秒跑（透過分 :00 與 :30 兩個 job 模擬）
# - GitHub Actions cron 實際最短間隔是 5 分鐘，所以靠 main.py 內部的
#   intensive_monitor（55 秒輪詢，每 3 秒一輪）來達到秒級延遲
# - 真正即時請在本機跑 websocket_monitor.py

on:
  schedule:
    # 每分鐘觸發。GitHub Actions 排程有延遲，實際大約每 1~3 分鐘
    - cron: '* * * * *'
  workflow_dispatch:
    inputs:
      command:
        description: '指令（留空=掃描；stats=持倉；daily=日報；learning=學習；tick=即時 check）'
        required: false
        default: ''

# 同時只能有一個 instance（避免 JSON race condition）
concurrency:
  group: alpha-oracle-prod
  cancel-in-progress: false

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: write

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          # 確保 git push 不會踩到別人的提交
          fetch-depth: 1

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'
          cache-dependency-path: requirements.txt

      - name: Install deps
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then
            pip install -r requirements.txt
          else
            pip install requests tradingview-ta
          fi

      - name: Run main.py
        env:
          TG_TOKEN: ${{ secrets.TG_TOKEN }}
          CHAT_ID: ${{ secrets.CHAT_ID }}
        run: |
          python main.py ${{ github.event.inputs.command }}

      - name: Commit state changes
        run: |
          git config user.name "alpha-bot"
          git config user.email "bot@noreply.github.com"
          # 只 commit 狀態檔，不動程式碼
          git add active_signals.json setups.json signal_cooldown.json \
                  system_state.json learning_state.json trade_history.json \
                  2>/dev/null || true
          if ! git diff --staged --quiet; then
            git commit -m "chore: 更新訊號狀態 [skip ci]"
            # Retry push to handle concurrent updates
            for i in 1 2 3; do
              git pull --rebase origin main && git push origin main && break
              echo "Push retry $i..."
              sleep 2
            done
          fi
