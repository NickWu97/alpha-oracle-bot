# Alpha Oracle Pro v15.5 — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual env
venv/
env/
.venv/
.env

# 機器人運行時的鎖檔
.alpha_oracle.lock

# Temp / log
*.log
*.tmp
*.swp
.DS_Store

# IDE
.vscode/
.idea/
*.iml

# 不要提交本機 secrets（GitHub Actions 用 secrets，本機請用 .env 但別 commit）
.env.local
secrets.json

