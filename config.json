{
  "_comment": "Alpha Oracle Pro v12 配置檔（熱更新，無需重新部署）。把這個檔案提交到 repo 即生效；不存在時程式會 fallback 到 DEFAULT_CONFIG。",

  "max_signals": 3,
  "score_threshold": 68,
  "cooldown_hours": 2,
  "signal_expire_hours": 24,
  "atr_max_pct": 0.04,

  "price_verification": {
    "_comment": "OKX vs TradingView 雙來源驗證",
    "enabled": true,
    "max_deviation_pct": 0.5,
    "block_on_unverified": false
  },

  "circuit_breaker": {
    "_comment": "連續虧損熔斷：以 trade_history.json 中最後 SL 起算",
    "enabled": true,
    "soft_threshold": 3,
    "soft_pause_hours": 4,
    "hard_threshold": 5,
    "hard_pause_hours": 24
  },

  "blackout_windows_tw": [
    { "start": "07:50", "end": "08:10", "reason": "資金費率結算（00 UTC）" },
    { "start": "15:50", "end": "16:10", "reason": "資金費率結算（08 UTC）" },
    { "start": "23:50", "end": "00:10", "reason": "資金費率結算（16 UTC）" },
    { "start": "21:25", "end": "21:45", "reason": "美股開盤波動" },
    { "start": "02:00", "end": "02:30", "reason": "FOMC 公布時段" }
  ]
}
